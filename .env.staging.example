# APETIT staging example — do not commit real secrets.
APETIT_ENVIRONMENT=staging
APETIT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/apetit_staging
APETIT_API_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
APETIT_CORS_ORIGINS=https://admin-staging.apetit.example

# Real login delivery required outside development.
APETIT_EMAIL_PROVIDER=smtp
APETIT_EMAIL_FROM=Apetit <acesso-staging@apetit.example>
APETIT_SMTP_HOST=smtp.provider.example
APETIT_SMTP_PORT=587
APETIT_SMTP_USERNAME=REPLACE_ME
APETIT_SMTP_PASSWORD=REPLACE_ME
APETIT_SMTP_STARTTLS=true
APETIT_SMTP_USE_SSL=false

# OCR for scanned nutrition plans.
APETIT_OCR_PROVIDER=google_vision
APETIT_GOOGLE_VISION_API_KEY=REPLACE_ME
APETIT_OCR_TIMEOUT_SECONDS=20
APETIT_OCR_PDF_MAX_PAGES=5
