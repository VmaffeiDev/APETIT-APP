APETIT_ENVIRONMENT=development
APETIT_DATABASE_URL=postgresql+psycopg://apetit:apetit@localhost:5432/apetit
APETIT_API_SECRET=change-me

# Login email delivery
# Use console only for local development. Set smtp in staging/production.
APETIT_EMAIL_PROVIDER=console
APETIT_EMAIL_FROM=Apetit <acesso@seudominio.com.br>
APETIT_SMTP_HOST=smtp.seuprovedor.com
APETIT_SMTP_PORT=587
APETIT_SMTP_USERNAME=
APETIT_SMTP_PASSWORD=
APETIT_SMTP_STARTTLS=true
APETIT_SMTP_USE_SSL=false

# Prescription OCR
# Set google_vision to enable OCR for images and scanned PDFs.
APETIT_OCR_PROVIDER=none
APETIT_GOOGLE_VISION_API_KEY=
APETIT_OCR_TIMEOUT_SECONDS=20
APETIT_OCR_PDF_MAX_PAGES=5
