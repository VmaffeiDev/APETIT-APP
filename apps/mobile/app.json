{
  "expo": {
    "name": "Apetit",
    "slug": "apetit-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F6F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apetit.app.demo"
    },
    "android": {
      "package": "com.apetit.app.demo",
      "navigationBar": {
        "backgroundColor": "#F7F6F2",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Apetit",
      "shortName": "Apetit",
      "themeColor": "#F7F6F2",
      "backgroundColor": "#F7F6F2"
    },
    "plugins": [
      "expo-document-picker"
    ]
  }
}
